{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc-projeto-2",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "btc-xpub",
      "database_id": "7c26213e-28f3-41d8-946c-742ec63b4c2f"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ELECTRUM_SERVERS": "electrum.blockstream.info:50002:tls,electrum.blockstream.info:50001:tcp",
    "ELECTRUM_TIMEOUT_MS": "8000",
    "EXTRAS_UNION": "on"
  }
}
