{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc-projeto-2",
  // O Worker deve responder só no domínio personalizado. Sem estas duas
  // chaves, o `wrangler deploy` reativa <nome>.raelales.workers.dev e as
  // preview URLs <versão>-<nome>.raelales.workers.dev a cada publicação.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
    // Os estáticos continuam sendo servidos pelo asset layer, que aplica
    // os cabeçalhos de public/_headers sem acordar o Worker. As respostas
    // dinâmicas recebem os mesmos cabeçalhos em src/config.js.
  },
  // Nada de D1/KV/R2: o projeto não guarda estado. O Durable Object abaixo
  // também não usa storage (sem put/alarm); ele só vive enquanto a tela
  // estiver aberta, com conexão Electrum e assinaturas em memória.
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCH",
        "class_name": "WalletWatcher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WalletWatcher"]
    }
  ],
  // Logs de invocação guardariam URL (com o id da sessão) e metadados no
  // Cloudflare; para manter o mínimo possível, ficam desligados. Ligue
  // temporariamente se precisar depurar.
  "observability": {
    "enabled": false
  },
  "vars": {
    // Fonte única de saldo/histórico: servidor Electrum (Sparrow usa os mesmos).
    "ELECTRUM_SERVERS": "electrum.blockstream.info:50002:tls,blockstream.info:700:tls,electrum.diynodes.com:50022:tls",
    "ELECTRUM_TIMEOUT_MS": "8000"
  }
}
