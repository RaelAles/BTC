{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc-projeto-2",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "btc-xpub",
      "database_id": "7c26213e-28f3-41d8-946c-742ec63b4c2f"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCH",
        "class_name": "WalletWatcher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WalletWatcher"]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    // Fonte única de saldo/histórico: servidor Electrum (Sparrow usa os mesmos).
    "ELECTRUM_SERVERS": "electrum.blockstream.info:50002:tls,blockstream.info:700:tls,electrum.diynodes.com:50022:tls",
    "ELECTRUM_TIMEOUT_MS": "8000",
    "SCAN_MAX": "400"
  }
}
