{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc",
  // O Worker deve responder só no domínio personalizado. Sem estas duas
  // chaves, o `wrangler deploy` reativa <nome>.raelales.workers.dev e as
  // preview URLs <versão>-<nome>.raelales.workers.dev a cada publicação.
  "workers_dev": false,
  "preview_urls": false,
  "main": "src/worker-proxy.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // As páginas HTML passam pelo Worker mesmo existindo no asset layer.
    // Sem isso o asset layer responde `/` antes do Worker e a recusa de
    // cabeçalho de reescrita de caminho (x-original-url e afins) nunca
    // valia ali: era o que o ZAP lia como "Bypassing 403". Os demais
    // estáticos seguem direto do asset layer.
    // A API também precisa passar pelo Worker: sem `/api/*` o asset layer
    // responde por ela (index.html no GET e 405 no POST), e nenhuma rota
    // dinâmica chega a rodar.
    // `/.well-known/*` idem: sem isso um manifesto ausente (ard.json,
    // ai-catalog.json) volta como 200 com o index.html, e quem espera JSON
    // reporta "malformed JSON" em vez do 404 que é a verdade.
    "run_worker_first": ["/", "/index.html", "/cofre-btc", "/cofre-btc.html", "/api/*", "/.well-known/*"],
    // Explicito para /cofre-btc (declarado em public/_headers) não mudar
    // de comportamento num bump do Wrangler.
    "html_handling": "auto-trailing-slash",
    // Caminho desconhecido serve a página (que desenha a tela 404), em vez
    // do 404 cru do asset layer. O Worker troca o status para 404 antes de
    // entregar a resposta, para o caminho não parecer um arquivo existente.
    "not_found_handling": "single-page-application"
    // Os demais estáticos continuam sendo servidos pelo asset layer, que
    // aplica os cabeçalhos de public/_headers sem acordar o Worker. As
    // respostas dinâmicas recebem os mesmos cabeçalhos em src/config.js.
  },
  // O domínio personalizado também fica declarado aqui, para um deploy a
  // partir do repositório reatar a rota sem depender do painel.
  "routes": [
    {
      "pattern": "btc.raelales.com",
      "custom_domain": true
    }
  ],
  // Nada de D1/KV/R2: o projeto não guarda estado. O Durable Object abaixo
  // também não usa storage (sem put/alarm); ele só vive enquanto a tela
  // estiver aberta, com a conexão Electrum e as assinaturas de scripthash
  // enviadas pelo navegador. Não há xpub nem lista derivada de endereços/pubkeys;
  // as transações cruas contêm os scripts públicos delas.
  "durable_objects": {
    "bindings": [
      {
        "name": "WATCH",
        "class_name": "WalletWatcher"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WalletWatcher"]
    }
  ],
  // Logs de invocação guardariam URL (com o id da sessão) e metadados no
  // Cloudflare; para manter o mínimo possível, ficam desligados. Ligue
  // temporariamente se precisar depurar.
  "observability": {
    "enabled": false
  },
  "vars": {
    // Fonte única de saldo/histórico: servidor Electrum (Sparrow usa os mesmos).
    "ELECTRUM_SERVERS": "electrum.blockstream.info:50002:tls,blockstream.info:700:tls,electrum.diynodes.com:50022:tls",
    "ELECTRUM_TIMEOUT_MS": "8000"
  }
}
