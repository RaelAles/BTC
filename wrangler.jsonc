{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "btc-projeto-2",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "btc-projeto-2",
      // Troque pelo UUID do D1 criado no painel (Storage & Databases → D1 →
      // btc-projeto-2). Com o placeholder o deploy falha com o erro 10021.
      "database_id": "COLE_O_ID_DA_D1_AQUI"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ELECTRUM_SERVERS": "electrum.blockstream.info:50002:tls,electrum.blockstream.info:50001:tcp",
    "ELECTRUM_TIMEOUT_MS": "8000",
    "EXTRAS_UNION": "on"
  }
}
